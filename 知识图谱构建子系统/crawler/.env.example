# ① 史密森尼 Open Access API Key
#    注册地址：https://api.data.gov/signup/
SI_DATA_GOV_API_KEY=你的key

# ② 哈佛艺术博物馆 API Key
#    申请地址：https://docs.google.com/forms/d/1Fe1H4nOhFkrLpaeBpLAnSrIMYvcAxnYWm0IU9a6IkFA/viewform
HARVARD_ART_MUSEUMS_API_KEY=你的key

RETRY_MAX_WAIT_SECONDS=60

# MySQL（可选）：同时设置 MYSQL_HOST 与 MYSQL_DATABASE 后，每批写入 CSV 时会 UPSERT 到库
# 密码请复制本文件为 .env 后自行填写
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码
MYSQL_DATABASE=你的数据库
MYSQL_TABLE=你的数据表
# MYSQL_CHARSET=utf8mb4

# Neo4j 知识图谱
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=你的密码

